# =====================================================================
# Kite FMCG — environment variables (copy to .env.local for development)
# Set the same variables in Vercel → Project → Settings → Environment Variables.
# NEVER commit real values.
# =====================================================================

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://www.kitepk.com
NEXT_PUBLIC_GA_ID=G-ZBCNV5GV6C

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://pslpiogqgohiznkasrmz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>
SUPABASE_SERVICE_ROLE_KEY=<service role key — server only, never NEXT_PUBLIC_>

# --- Admin login (required) ---
ADMIN_EMAIL=admin@kitepk.com
# Generate both with: node scripts/hash-admin-password.mjs "YourNewStrongPassword"
ADMIN_PASSWORD_HASH='<bcrypt hash>'
ADMIN_JWT_SECRET=<random string, at least 32 characters>
# (Legacy alternative to the hash — avoid in production)
# ADMIN_PASSWORD=<strong password>

# --- Email via Resend (required for order emails) ---
RESEND_API_KEY=<resend api key>
RESEND_FROM=Kite FMCG Orders <orders@send.kitepk.com>
# Extra admin recipients (sales@kitepk.com and kitematchpk@gmail.com always receive orders)
ADMIN_ORDER_EMAIL=
ADMIN_PANEL_URL=https://www.kitepk.com/admin/orders

# --- Pusher real-time admin notifications ---
NEXT_PUBLIC_PUSHER_KEY=d14edc647970149caa98
NEXT_PUBLIC_PUSHER_CLUSTER=ap2
# Server-side (required for real-time alerts to actually be sent)
PUSHER_APP_ID=<app id>
PUSHER_KEY=d14edc647970149caa98
PUSHER_SECRET=<secret>
PUSHER_CLUSTER=ap2
